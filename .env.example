# HTTP/WS portu
PORT=4173

# Dinlenecek arayüz (internete açarken 0.0.0.0, sadece yerel için 127.0.0.1)
HOST=0.0.0.0

# Dışarı açarken mutlaka ayarlayın:
# OFFICE_TOKEN=uzun-rastgele-bir-deger

# Docker modu (1 = 10 Hermes profilini yönet, 0 = demo simülasyonu)
HERMES_DOCKER=0
HERMES_CONTAINER=kodmoz-hermes
HERMES_DATA_DIR=./runtime/hermes-data
