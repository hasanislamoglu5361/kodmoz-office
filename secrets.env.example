# Bu dosyayı runtime/secrets.env olarak kopyalayın ve doldurun.
# runtime/ git'e girmez.

HERMES_LLM_BASE_URL=https://api.commandcode.ai/provider/v1
HERMES_LLM_MODEL=deepseek/deepseek-v4.1-flash
HERMES_LLM_API_KEY=replace-me

# openssl rand -hex 32
HERMES_AGENTS_API_KEY=replace-with-a-long-random-secret

# Konteynerden ofis sunucusuna erişim.
# Docker Desktop: host.docker.internal
# Linux: host makinenin LAN/Tailscale IP'si
OFFICE_URL=http://host.docker.internal:4173
